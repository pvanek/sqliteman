      <widget class="QCheckBox" name="strict">
       <property name="text">
        <string>S&amp;trict</string>
       </property>
       <property name="toolTip">
        <string>Every value must be of its column's type: INTEGER, REAL, TEXT, BLOB or ANY</string>
       </property>
      </widget>
     </item>
     <item>
