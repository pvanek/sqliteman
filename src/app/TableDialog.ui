     <item>
      <widget class="QCheckBox" name="ifNotExists">
       <property name="text">
        <string>&amp;If not exists</string>
       </property>
       <property name="toolTip">
        <string>Do nothing, rather than fail, when a table of that name is there</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QCheckBox" name="withoutRowid">
       <property name="text">
        <string>&amp;Without rowid</string>
       </property>
       <property name="toolTip">
